<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose drives the actual theming via FintrackTheme; this XML theme
      exists only to provide a sane window background and status bar colour
      before Compose has rendered.
    -->
    <style name="Theme.Fintrack" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
