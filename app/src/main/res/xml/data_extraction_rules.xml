<?xml version="1.0" encoding="utf-8"?>
<!--
  Forbid Android Auto Backup and Device-to-Device transfer for ALL data.
  Backups in FinTrack are user-driven, encrypted, and produced explicitly via
  the Settings → Backup screen. The OS must never ship our DB or shared_prefs
  off the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
