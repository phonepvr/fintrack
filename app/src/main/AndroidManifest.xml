<?xml version="1.0" encoding="utf-8"?>
<!--
  FinTrack — offline-first portfolio tracker.

  PRIVACY GUARANTEE: this manifest deliberately declares NO permissions related
  to networking. The app must never gain INTERNET, ACCESS_NETWORK_STATE, or
  ACCESS_WIFI_STATE — adding any of them is enforced by the test
  com.fintrack.privacy.ManifestPermissionsTest and will fail CI.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Explicitly deny features that imply network capability. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <queries>
        <!-- No queries declared. The app does not communicate with other apps. -->
    </queries>

    <application
        android:name=".FintrackApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fintrack"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|locale|layoutDirection|fontScale|uiMode"
            android:theme="@style/Theme.Fintrack">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
